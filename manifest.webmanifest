{
  "name": "Calorias e Macros",
  "short_name": "Calorias",
  "description": "Registro pessoal de calorias, macros e metas",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a110d",
  "theme_color": "#0a110d",
  "shortcuts": [
    {
      "name": "Falar o que comeu",
      "short_name": "Falar",
      "url": "./#adicionar?falar=1",
      "icons": [
        {
          "src": "icons/atalho-falar.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Foto do prato (estimar calorias)",
      "short_name": "Foto do prato",
      "url": "./#adicionar?foto=1",
      "icons": [
        {
          "src": "icons/atalho-foto.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Ler código de barras",
      "short_name": "Código",
      "url": "./#adicionar?scan=1",
      "icons": [
        {
          "src": "icons/atalho-codigo.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Registrar peso",
      "short_name": "Peso",
      "url": "./#registros?aba=peso",
      "icons": [
        {
          "src": "icons/atalho-peso.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Água +250 mL",
      "short_name": "Água",
      "url": "./#diario?acao=agua&ml=250",
      "icons": [
        {
          "src": "icons/atalho-agua.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Adicionar alimento",
      "short_name": "Adicionar",
      "url": "./#adicionar",
      "icons": [
        {
          "src": "icons/atalho-adicionar.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "id": "./",
  "categories": [
    "health",
    "fitness",
    "food"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "imagens",
          "accept": [
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".heic"
          ]
        }
      ]
    }
  }
}
